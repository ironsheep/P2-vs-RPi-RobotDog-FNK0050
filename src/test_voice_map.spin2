'' =================================================================================================
''   File....... test_voice_map.spin2
''   Purpose.... CATALOG the dog voice vocabulary from scratch (trusting no prior map): registers the
''               custom-word table, then walks the word list and CAPTURES whatever CMDID each spoken word
''               actually returns. Advance is MANUAL -- say the NEXT control word to lock the current
''               capture and move on -- so retries/stray hits never lose your place. IO cog only -- dog-safe.
''   Authors.... Stephen M Moraco -- (c) 2026 Iron Sheep Productions, LLC  (MIT)
'' =================================================================================================
'
'  Wake the module (say the wake word) so it is listening, then say each prompted word. Non-command
'  CMDIDs (the wake word, mis-hears) are reported and IGNORED -- the prompt stays until its word arrives.
'  Run: pnut-ts -d -q test_voice_map.spin2  then  pnut-term-ts -r test_voice_map.bin -b 2000000
'  (headless: add  --headless --end-marker "VOICE_MAP_DONE" --timeout 240)

CON
  _clkfreq    = 200_000_000
  DEBUG_BAUD  = 2_000_000

  PIN_WS2812  = 8                                              ' committed adapter map (CLAUDE.md / wiring sec 3)
  PIN_ECHO    = 9
  PIN_BUZZER  = 10
  PIN_TRIG    = 11
  PIN_VSCL    = 18                                             ' voice bus SCL
  PIN_VSDA    = 16                                             ' voice bus SDA

  COG_STACK   = 256
  PROBE_MS    = 600                                            ' let the IO cog run its DF2301Q probe before we read voicePresent()
  POLL_MS     = 25                                             ' telemetry watch cadence
  REPROMPT_MS = 6000                                           ' re-print the current prompt if nothing arrives for this long
  GIVEUP_MS   = 30000                                          ' backstop: auto-advance after this much SILENCE (no recognitions)
  MS_DIV      = 1000                                           ' clkfreq / 1000 = ticks per millisecond
  ' Manual NEXT control: say this BUILT-IN word to LOCK the current word's capture and advance. Built-ins
  ' are always factory-recognized (works even when a custom word won't) and distinct from our slots 5..21.
  ' Default = "Read Compass".
  NEXT_CMDID  = 68
  CATALOG_COUNT = 17                                           ' the 17 custom slots 5..21 (= names.CUSTOM_COUNT)

OBJ
  io     : "isp_io_controller"                                ' cog: discrete pins + 2nd I2C bus (voice)
  names  : "isp_voice_command_names"                          ' ID -> phrase + custom-word registration
  stack  : "isp_stack_check"                                  ' COG stack-overflow detector

DAT ' ---- cog launch stack, followed IMMEDIATELY by its overflow sentinel ----
  ioStack      LONG  0[COG_STACK]
  ioStackMark  LONG  stack.DO_NOT_WRITE_MARK

DAT ' ---- dog custom-word vocabulary (training order == CMDID 5..21; see VOICE-COMMAND-MAP.md) ----
  dogVocab
    byte  5, "Stand", 0
    byte  6, "Sit", 0
    byte  7, "Lie Down", 0
    byte  8, "Crouch", 0
    byte  9, "Relax", 0
    byte 10, "Take a Bow", 0
    byte 11, "Forward", 0
    byte 12, "Backward", 0
    byte 13, "Turn Left", 0
    byte 14, "Turn Right", 0
    byte 15, "Halt", 0
    byte 16, "Say Hi", 0
    byte 17, "Shake", 0
    byte 18, "Salute", 0
    byte 19, "Push Ups", 0
    byte 20, "Nod Yes", 0
    byte 21, "Parade Rest", 0
    byte  0                                                   ' end-of-table marker

DAT ' ---- per-word capture store (end-of-run summary; index = slot - CUSTOM_FIRST) ----
  capturedIds  LONG  0[CATALOG_COUNT]

PUB main() | ioCog, wordSlot, lastSeq, curSeq, actualId, capturedId, bGotIt, nCaptured, status, reTick, giveUpTick
'' Bring up the IO cog (voice), register the custom table, and CATALOG each word: capture whatever CMDID
'' it returns, advancing ONLY when the NEXT control word is heard (or after GIVEUP_MS of silence). Manual
'' advance means retries and stray hits never lose your place. Run twice and diff for a trusted catalog.
''
'' @local ioCog - cog id the IO controller launched into (negative on failure)
'' @local wordSlot - vocabulary entry being prompted (its phrase = cmdName(wordSlot))
'' @local lastSeq - previous voice-recognition sequence (freshness edge detect)
'' @local curSeq - voice-recognition sequence read this pass
'' @local actualId - the CMDID actually recognized this pass
'' @local capturedId - the latest non-noise CMDID captured for the current word (0 = none yet)
'' @local nCaptured - running count of words that captured something
'' @local status - registerCustomTable() result (0 = REG_OK)
'' @local reTick - getct() deadline to re-print the current prompt
'' @local giveUpTick - getct() deadline to auto-advance after silence

    waitms(100)
    DEBUG("=== voice command-map CATALOG (DF2301Q) -- capture each word; manual NEXT advance ===")

    stack.prepStackForCheck(@ioStack, COG_STACK)
    ioCog := cogspin(NEWCOG, io.startWithVoice(PIN_WS2812, PIN_BUZZER, PIN_TRIG, PIN_ECHO, PIN_VSCL, PIN_VSDA), @ioStack)
    if ioCog < 0
        DEBUG("FAILED to start IO cog -- aborting")
        DEBUG("VOICE_MAP_DONE")
        repeat
    io.setStackCheck(@ioStack, COG_STACK)
    waitms(PROBE_MS)

    status := names.registerCustomTable(@dogVocab)
    DEBUG("custom vocab register = ", sdec_(status), "  (0 = REG_OK)")

    if not io.voicePresent()
        DEBUG("voice present = F -- module absent/unpowered; cannot catalog. Aborting.")
        DEBUG("VOICE_MAP_DONE")
        repeat

    DEBUG("voice present = T. CATALOG mode -- say each prompted word; retry until it's heard CORRECTLY.")
    DEBUG("Once the right word lands it LATCHES -- a later mishear will NOT overwrite it. Then say")
    DEBUG("'", zstr_(names.cmdName(NEXT_CMDID)), "' to lock it and go NEXT. Only NEXT advances. (", udec_(GIVEUP_MS / MS_DIV), "s of silence auto-advances.)")

    nCaptured := 0
    lastSeq := io.getVoiceSeq()
    repeat wordSlot from names.CUSTOM_FIRST to names.CUSTOM_LAST
        DEBUG(" ")
        DEBUG("SAY ---> '", zstr_(names.cmdName(wordSlot)), "'   (word ", udec_(wordSlot - names.CUSTOM_FIRST + 1), " of 17) -- then '", zstr_(names.cmdName(NEXT_CMDID)), "' for NEXT")
        capturedId := 0
        bGotIt := FALSE                                       ' TRUE once the word's OWN CMDID is captured (then later mishears are ignored)
        reTick := getct() + (REPROMPT_MS * (clkfreq / MS_DIV))
        giveUpTick := getct() + (GIVEUP_MS * (clkfreq / MS_DIV))
        repeat
            curSeq := io.getVoiceSeq()
            if curSeq <> lastSeq
                lastSeq := curSeq
                actualId := io.getVoiceCmdId()
                giveUpTick := getct() + (GIVEUP_MS * (clkfreq / MS_DIV))   ' activity -> reset the silence backstop
                if actualId == NEXT_CMDID
                    lockCapture(wordSlot, capturedId)
                    quit
                elseif actualId == 1 or actualId == 2 or actualId == 255    ' learning / wake / unknown -- noise, not a capture
                    DEBUG("   (ignored CMDID ", udec_(actualId), " '", zstr_(names.cmdName(actualId)), "' -- wake/unknown)")
                elseif actualId == wordSlot                                 ' the word's OWN slot -- the correct capture
                    capturedId := actualId
                    bGotIt := TRUE                                          ' latch: a later mishear will NOT overwrite this
                    DEBUG("   captured CMDID ", udec_(actualId), " ('", zstr_(names.cmdName(actualId)), "') -- CORRECT; '", zstr_(names.cmdName(NEXT_CMDID)), "' for NEXT")
                elseif not bGotIt                                           ' a wrong word, but we have not gotten the correct one yet
                    capturedId := actualId
                    DEBUG("   captured CMDID ", udec_(actualId), " ('", zstr_(names.cmdName(actualId)), "') -- not '", zstr_(names.cmdName(wordSlot)), "'; say again, or '", zstr_(names.cmdName(NEXT_CMDID)), "' for NEXT")
                else                                                        ' already have the correct one -- ignore a later mishear
                    DEBUG("   (ignoring CMDID ", udec_(actualId), " '", zstr_(names.cmdName(actualId)), "' -- already captured '", zstr_(names.cmdName(wordSlot)), "')")
            elseif (getct() - giveUpTick) >= 0
                lockCapture(wordSlot, capturedId)
                quit
            elseif (getct() - reTick) >= 0
                DEBUG("   ...waiting -- say '", zstr_(names.cmdName(wordSlot)), "', then '", zstr_(names.cmdName(NEXT_CMDID)), "' for NEXT")
                reTick := getct() + (REPROMPT_MS * (clkfreq / MS_DIV))
            waitms(POLL_MS)
        capturedIds[wordSlot - names.CUSTOM_FIRST] := capturedId  ' remember it for the summary
        if capturedId <> 0
            nCaptured++

    DEBUG(" ")
    DEBUG("=== CATALOG SUMMARY (compare this block across two runs -- identical == trusted) ===")
    repeat wordSlot from names.CUSTOM_FIRST to names.CUSTOM_LAST
        actualId := capturedIds[wordSlot - names.CUSTOM_FIRST]
        if actualId <> 0
            DEBUG("  '", zstr_(names.cmdName(wordSlot)), "'  ->  CMDID ", udec_(actualId))
        else
            DEBUG("  '", zstr_(names.cmdName(wordSlot)), "'  ->  (none)")
    DEBUG("=== ", udec_(nCaptured), " of 17 captured ===")
    DEBUG("VOICE_MAP_DONE")
    repeat

PRI lockCapture(wordSlot, capturedId)
' Print the locked 'word -> CMDID' catalog line for the just-finished word.
'
' @param wordSlot - the vocabulary slot just prompted (its phrase = cmdName(wordSlot))
' @param capturedId - the captured CMDID (0 = nothing captured)

    if capturedId <> 0
        DEBUG("   LOCKED: '", zstr_(names.cmdName(wordSlot)), "'  ->  CMDID ", udec_(capturedId), "  ('", zstr_(names.cmdName(capturedId)), "')")
    else
        DEBUG("   LOCKED: '", zstr_(names.cmdName(wordSlot)), "'  ->  (nothing captured)")

CON ' ---- License ----

